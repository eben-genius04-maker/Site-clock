 // SiteClock — Prisma schema
// Postgres via Supabase. Auth identity lives in Supabase's auth.users table;
// User below mirrors it 1:1 (id = Supabase auth uid) so we can join freely
// in application queries without touching the protected auth schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum AttendanceMethod {
  GPS
  QR_CODE
  FACE
  FINGERPRINT
  MANUAL
}


enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_DEPARTURE
  ABSENT
  FLAGGED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FLEXIBLE
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

// ---------- Core tenancy ----------

model Company {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  timezone  String   @default("Africa/Accra")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  employees       Employee[]
  departments     Department[]
  officeLocations OfficeLocation[]
  shifts          Shift[]
  leaveRequests   LeaveRequest[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  settings        CompanySettings?

  @@map("companies")
}

// Mirrors Supabase auth.users — id must equal the Supabase auth uid.
model User {
  id        String   @id
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?

  @@index([companyId])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  employees Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

model OfficeLocation {
  id            String   @id @default(uuid())
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Int      @default(150)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("office_locations")
}

// ---------- Employees ----------

model Employee {
  id               String           @id @default(uuid())
  employeeCode     String           // e.g. SC-2026-0001
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  fullName         String
  email            String
  phone            String?
  position         String?
  photoUrl         String?
  dateEmployed     DateTime?
  salary           Decimal?         @db.Decimal(12, 2)
  emergencyContact String?
  address          String?
  status           EmploymentStatus @default(ACTIVE)
  qrCodeToken      String           @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  shiftAssignments EmployeeShift[]
  payrollEntries   PayrollEntry[]
  webauthnCredentials WebAuthnCredential[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@map("employees")
}

// ---------- Shifts ----------
 model Shift {
  id        String    @id @default(uuid())
  name      String
  type      ShiftType
  startTime String    // "08:00" — stored as HH:mm, timezone applied at company level
  endTime   String    // "17:00"
  gracePeriodMinutes Int @default(10)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  assignments EmployeeShift[]

  @@index([companyId])
  @@map("shifts")
}

model EmployeeShift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  @@index([employeeId])
  @@index([shiftId])
  @@map("employee_shifts")
}

// ---------- Attendance ----------

model Attendance {
  id         String            @id @default(uuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  clockInAt   DateTime?
  clockOutAt  DateTime?
  method      AttendanceMethod
  status      AttendanceStatus @default(ON_TIME)

  clockInLat   Float?
  clockInLng   Float?
  clockInAddress String?
  distanceFromOfficeM Float?

  clockOutLat  Float?
  clockOutLng  Float?

  faceMatchConfidence Float?   // 0–1, set when method = FACE
  needsReview          Boolean @default(false)

  workedMinutes    Int? // computed on clock-out
  overtimeMinutes  Int  @default(0)
  lateMinutes      Int  @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, clockInAt])
  @@map("attendance")
}

// ---------- Leave ----------

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  reviewerComment String?
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId, status])
  @@map("leave_requests")
}

// ---------- Payroll ----------

model PayrollEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  regularMinutes  Int     @default(0)
  overtimeMinutes Int     @default(0)
  lateDeduction   Decimal @default(0) @db.Decimal(12, 2)
  absenceDeduction Decimal @default(0) @db.Decimal(12, 2)
  grossPay        Decimal @default(0) @db.Decimal(12, 2)
  netPay          Decimal @default(0) @db.Decimal(12, 2)

  generatedAt DateTime @default(now())

  @@index([employeeId, periodStart])
  @@map("payroll_entries")
}

// ---------- Notifications / audit / settings ----------

model Notification {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String   // recipient — a User.id
  title     String
  body      String
  read      Boolean  @default(false)
  channel   String   @default("in_app") // "in_app" | "email"
  createdAt DateTime @default(now())

  @@index([companyId, userId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId   String?  // User.id, null for system actions
  action    String   // e.g. "employee.created", "attendance.manual_override"
  entity    String   // e.g. "Employee", "Attendance"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
 @@index([companyId, createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id                String  @id @default(uuid())
  companyId         String  @unique
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workStartTime     String  @default("08:00")
  workEndTime       String  @default("17:00")
  attendanceRadiusM Int     @default(150)
  weekendDays       Int[]   @default([1, 7]) // 1 = Sunday ... 7 = Saturday
  passwordMinLength Int     @default(8)
  holidayCalendar   Json?   // [{ date: "2026-03-06", name: "Independence Day" }]

  @@map("company_settings")
}

// ---------- WebAuthn (fingerprint / device biometric clock-in) ----------
// Each row is one registered device credential. An employee can register
// more than one device (e.g. work phone + laptop). Stores only the public
// key and a signature counter — never any actual biometric data, which
// never leaves the employee's device.

model WebAuthnCredential {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  credentialId String   @unique // base64url, from the authenticator
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceName   String? // e.g. "iPhone", "Windows laptop" — best-effort label
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([employeeId])
  @@map("webauthn_credentials")
}